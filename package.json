  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "app": "tsx apps/corepoint/server.ts",
    "cli": "tsx src/cli.ts",
